# Copy to .env, then run: docker compose up -d --build
# Port on this machine that serves the dashboard
PORT=8855
TIMEZONE=America/Boise
# First-run default only. true = simulated demo house. You can switch in the app (click the
# "Demo data" badge or use the Devices page); that choice is remembered. Demo and real data
# are kept in separate files.
DEMO_MODE=true
# Long random string shared with the collector, e.g. output of: openssl rand -hex 24
INGEST_KEY=
